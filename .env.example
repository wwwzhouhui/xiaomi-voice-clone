# 复制为 .env（本地）或粘贴到 Vercel Settings → Environment Variables。
# 注意：不要把真实 Key 提交进 Git 仓库。
XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1
XIAOMI_MODEL=mimo-v2.5-tts-voiceclone
XIAOMI_API_KEY=
XIAOMI_OUTPUT_FORMAT=mp3
ADMIN_PASSWORD=请设置一个强口令
# CLONE_PASSWORD=留空表示首页公开生成；填了则首页生成时要输入该密码
# XIAOMI_MOCK=1 仅本地测试用，生产环境不要设置
